# meta-ads-manager — личный конфиг. Живёт в ~/.config/meta-ads-manager/meta.env (chmod 600), не в репозитории.
# Токен сюда вписывает команда `python3 setup.py token` — вручную в чат с агентом его не вставляйте.
META_TOKEN=

# utm_medium в метках сайта: название вашего агентства или канала (латиница, без пробелов).
META_UTM_MEDIUM=meta_ads

# Площадки, если в спеке их нет. Метод: instagram,threads (ролик показывается целиком).
# Варианты: instagram | instagram,threads | instagram,facebook | instagram,threads,facebook
META_DEFAULT_PLATFORMS=instagram,threads

# Версия Graph API. Менять только когда Meta выпустит новую и скилл обновится.
GRAPH_VERSION=v26.0

# Путь к Chrome для листа превью, если он стоит не в стандартном месте.
# META_CHROME=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
